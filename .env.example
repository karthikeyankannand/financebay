# FinanceBay Environment Variables

# Database Configuration
# For local development, leave DATABASE_URL empty (uses SQLite)
# For production, add your Supabase PostgreSQL connection string
DATABASE_URL=

# Example PostgreSQL URL (Supabase):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Session Secret (change this for production)
SESSION_SECRET=financebay-secret-key-2024-change-this-in-production

# Port (optional, defaults to 3000)
PORT=3000

# Node Environment
NODE_ENV=development
